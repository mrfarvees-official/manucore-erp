<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version> <!-- use the latest 4.x from start.spring.io -->
        <relativePath/>
    </parent>

    <groupId>com.manucore</groupId>
    <artifactId>manucore-erp</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <properties>
        <java.version>25</java.version>  <!-- compiles fine on your JDK 25 -->
        <spring-cloud.version>2025.1.3</spring-cloud.version> <!-- must match Boot line -->
        <spring-framework.version>7.0.9</spring-framework.version>
    </properties>

    <modules>
        <module>libs/event-contracts</module>
        <module>services/gateway-service</module>
        <module>services/identity-tenant-service</module>
        <module>services/master-data-service</module>
        <module>services/inventory-service</module>
        <module>services/procurement-service</module>
        <module>services/production-service</module>
        <module>services/quality-service</module>
        <module>services/reporting-service</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.manucore</groupId>
                <artifactId>event-contracts</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>42.7.14</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>